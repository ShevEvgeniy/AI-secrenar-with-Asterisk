# Gateway runtime env template (example only - DO NOT commit real secrets)
# For future operator-run deployment only. Keep real values in the operator vault.

# OpenAI key (gateway-only)
OPENAI_API_KEY=

# Gateway bearer token for Asterisk clients
GATEWAY_TOKEN=

# Bind address for application internal port (use loopback or private IP)
GATEWAY_BIND=127.0.0.1:8081

# Health endpoint auth token (optional)
HEALTH_TOKEN=

# Feature flags (default safe values)
STT_GATEWAY_STT_ENABLED=false
STT_GATEWAY_ADAPTER_ENABLED=false
STT_GATEWAY_USE_TRANSCRIPT_FOR_DIALOG=false
STT_GATEWAY_LOG_TRANSCRIPT=false
