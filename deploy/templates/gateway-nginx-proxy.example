# Example nginx reverse proxy configuration (placeholder only - do not apply from the repo)
# Future operators must replace all hostnames, certificate paths, and allowlists manually.

server {
    listen 443 ssl http2;
    server_name gateway.example.com;

    ssl_certificate /etc/letsencrypt/live/gateway.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gateway.example.com/privkey.pem;

    # Harden TLS; adapt as needed.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers "HIGH:!aNULL:!MD5";

    # Restrict source CIDRs before production use.
    # allow 203.0.113.10/32;
    # deny all;

    location / {
        proxy_pass http://127.0.0.1:8081/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Do not hardcode bearer tokens in nginx config.
    }

    location = /health {
        proxy_pass http://127.0.0.1:8081/health;
        # Use gateway-side auth or mTLS; do not hardcode real tokens in this template.
    }
}
