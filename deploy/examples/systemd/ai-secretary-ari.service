[Unit]
Description=AI Secretary ARI app
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=tulauser
Group=tulauser
WorkingDirectory=/home/tulauser/AI-secrenar-with-Asterisk-node014
EnvironmentFile=/etc/ai-secretary/ari-app.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/ai-secretary-ari-wrapper
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
