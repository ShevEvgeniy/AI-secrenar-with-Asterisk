# Example Asterisk-server client settings for the supported-region STT gateway.
# Install only if running a measurement client. Do not add OPENAI_API_KEY here.
# Keep the installed file owner-readable only and out of git.

STT_GATEWAY_URL=https://replace-with-supported-region-gateway.example.com
STT_GATEWAY_TOKEN=replace-with-random-gateway-token
STT_GATEWAY_TIMEOUT_SECONDS=45
REALTIME_GATEWAY_URL=https://replace-with-supported-region-gateway.example.com/v1/stt/realtime-measurement
REALTIME_GATEWAY_TOKEN=replace-with-random-gateway-token

# Keep local service profile diagnostic-only until a later node explicitly changes it.
STT_LIVE_STREAMING_PROVIDER=rtp_diagnostics_only
STT_LIVE_OPENAI_DISABLED=true
STT_LIVE_DIAGNOSTICS_DIALOG_ISOLATED=true
STT_LIVE_STREAMING_USE_LIVE_TRANSCRIPT=false
