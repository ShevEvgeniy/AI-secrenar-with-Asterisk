# Example environment for the supported-region STT gateway.
# Install only on the gateway host, not on the Asterisk server.
# Keep the installed file owner-readable only and out of git.

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8443
GATEWAY_REGION_LABEL=eu

# Gateway-to-OpenAI secret. Replace on the gateway host only.
OPENAI_API_KEY=replace-with-openai-api-key-on-gateway-only

# Asterisk-to-gateway shared bearer token. Replace with a random secret.
GATEWAY_TOKEN=replace-with-random-gateway-token
STT_GATEWAY_SERVER_TOKEN=replace-with-random-gateway-token

OPENAI_REALTIME_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_LANGUAGE=ru
OPENAI_REALTIME_TIMEOUT_SECONDS=30

STT_GATEWAY_MAX_AUDIO_SECONDS=15
STT_GATEWAY_MAX_AUDIO_BYTES=1048576
STT_GATEWAY_RETURN_TRANSCRIPT_DEFAULT=false
STT_GATEWAY_LOG_TRANSCRIPT_TEXT=false
